# Placeholder examples only. This application does not automatically load .env.
# Export variables in your shell, or use your local secret manager.
ZETARIS_REST_URL=https://YOUR-ASSIGNED-INSTANCE/api/v1.0
ZETARIS_API_KEY=YOUR-LOCAL-SECRET
ZETARIS_ORG_ID=YOUR-NUMERIC-ORG-ID
ZETARIS_ALLOWED_TABLES=TEAM.recall,TEAM.inventory,TEAM.intake_ledger,TEAM.supplier_aliases,TEAM.transfers

# Defaults use the pinned vendored H-MEM engine and project node_modules/tsx.
# Override only when using a separately installed official engine.
# METERLESS_HMEM_DIR=/absolute/path/to/official/hmem/reference
# METERLESS_TSX_CLI=/absolute/path/to/tsx/dist/cli.mjs
# METERLESS_STATE_DIR=/absolute/path/to/private/local/memory

# Optional NVIDIA critique. Never set real secrets in this file.
NVIDIA_API_KEY=YOUR-LOCAL-SECRET
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
